generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  ADMIN
  MASTER
}

enum OfferType {
  GLOBAL
  HOT_SLOT
}

model User {
  id                 String          @id @default(cuid())
  firstName          String
  lastName           String
  email              String          @unique
  phone              String?
  countryCode        String?
  password           String?
  role               Role            @default(CLIENT)
  verificationCode   String?
  emailVerified      Boolean         @default(false)
  telegramChatId     String?         @unique
  telegramUsername   String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  notifyAppointments Boolean         @default(true)
  notifyPromotions   Boolean         @default(false)
  image              String?
  averageRating      Float           @default(5.0)
  reviewsCount       Int             @default(0)
  sentMessages       Message[]       @relation("SentMessages")
  receivedMessages   Message[]       @relation("ReceivedMessages")
  masterProfile      MasterProfile?
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@unique([email, token])
}

model Message {
  id         String   @id @default(cuid())
  text       String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  senderId   String
  receiverId String
  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
}

model Service {
  id           String         @id @default(cuid())
  name         String
  duration     Int
  price        Float
  image        String?
  isActive     Boolean        @default(true)
  rating       Float          @default(0)
  reviewsCount Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  specialOffers SpecialOffer[]
}

model MasterProfile {
  id             String         @id @default(cuid())
  userId         String         @unique
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialization String
  status         String         @default("WORKING")
  rating         Float          @default(0)
  reviewsCount   Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  specialOffers  SpecialOffer[]
}

model SalonSettings {
  id                  String       @id @default("default")
  allowWeekendBooking Boolean      @default(false)
  telegramBotActive   Boolean      @default(false)
  workingDays         WorkingDay[]
  updatedAt           DateTime     @updatedAt
}

model WorkingDay {
  id         String        @id @default(cuid())
  dayOfWeek  Int
  isOpen     Boolean       @default(true)
  startTime  String        @default("09:00")
  endTime    String        @default("18:00")
  settingsId String
  settings   SalonSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  @@unique([settingsId, dayOfWeek])
}

model SpecialOffer {
  id        String    @id @default(cuid())
  type      OfferType @default(GLOBAL)
  title     String
  discount  String // Наприклад "20%" або "500 грн"
  isActive  Boolean   @default(true)
  
  // Поля для "Гарячих вікон" (HOT_SLOT)
  dateTime  DateTime?
  masterId  String?
  master    MasterProfile? @relation(fields: [masterId], references: [id])
  serviceId String?
  service   Service?       @relation(fields: [serviceId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TelegramBroadcast {
  id             String   @id @default(cuid())
  text           String
  recipientCount Int
  sentAt         DateTime @default(now())
}