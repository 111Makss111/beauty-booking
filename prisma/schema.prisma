generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  ADMIN
  MASTER
}

enum OfferType {
  GLOBAL
  HOT_SLOT
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model User {
  id                 String            @id @default(cuid())
  firstName          String
  lastName           String
  email              String            @unique
  phone              String?
  countryCode        String?
  password           String?
  role               Role              @default(CLIENT)
  verificationCode   String?
  emailVerified      Boolean           @default(false)
  telegramChatId     String?           @unique
  telegramUsername   String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt 
  notifyAppointments Boolean           @default(true)
  notifyPromotions   Boolean           @default(false)
  image              String?
  averageRating      Float             @default(5.0)
  reviewsCount       Int               @default(0)
  sentMessages       Message[]         @relation("SentMessages")
  receivedMessages   Message[]         @relation("ReceivedMessages")
  masterProfile      MasterProfile?
  appointments       Appointment[]     @relation("ClientAppointments")
  expectingReviewFor String?
  bonusBalance Float @default(0)
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@unique([email, token])
}

model Message {
  id         String   @id @default(cuid())
  text       String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  senderId   String
  receiverId String
  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
}

model Service {
  id            String         @id @default(cuid())
  name          String
  duration      Int
  price         Float
  image         String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  specialOffers SpecialOffer[]
  appointments  Appointment[]
}

model ExtraOption {
  id           String        @id @default(cuid())
  name         String
  price        Float
  duration     Int           @default(0)
  isActive     Boolean       @default(true)
  appointments Appointment[] @relation("AppointmentExtras")
}

model MasterProfile {
  id             String         @id @default(cuid())
  userId         String         @unique
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialization String
  status         String         @default("WORKING")
  rating         Float          @default(0)
  reviewsCount   Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  specialOffers  SpecialOffer[]
  appointments   Appointment[]
}

model Appointment {
  id           String            @id @default(cuid())
  clientId     String
  client       User              @relation("ClientAppointments", fields: [clientId], references: [id])
  masterId     String
  master       MasterProfile     @relation(fields: [masterId], references: [id])
  serviceId    String
  service      Service           @relation(fields: [serviceId], references: [id])
  extraOptions ExtraOption[]     @relation("AppointmentExtras")
  
  dateTime     DateTime
  endTime      DateTime
  totalPrice   Float
  status       AppointmentStatus @default(PENDING)
  notes        String?
  
  review       Review?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model Review {
  id            String      @id @default(cuid())
  rating        Int
  comment       String?
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  isVisible     Boolean     @default(true)
}

model SalonSettings {
  id       String @id @default("general_config")
  allowWeekendBooking Boolean      @default(false)
  bookingInterval     Int          @default(30)
  maxBookingDays      Int          @default(30)
  minBookingNotice    Int          @default(60)
  telegramBotActive   Boolean      @default(false)
  workingDays         WorkingDay[]
  updatedAt           DateTime     @updatedAt
  schedule Json   @default("{}")
}

model WorkingDay {
  id         String        @id @default(cuid())
  dayOfWeek  Int
  isOpen     Boolean       @default(true)
  startTime  String        @default("09:00")
  endTime    String        @default("18:00")
  settingsId String
  settings   SalonSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  @@unique([settingsId, dayOfWeek])
}

model SpecialOffer {
  id        String    @id @default(cuid())
  type      OfferType @default(GLOBAL) // GLOBAL або HOT_SLOT
  title     String
  discount  Float     // Знижка у відсотках (наприклад, 20.0 для 20%)
  isActive  Boolean   @default(true)
  dateTime  DateTime? // Для HOT_SLOT: конкретна дата і час візиту
  masterId  String?
  master    MasterProfile? @relation(fields: [masterId], references: [id])
  serviceId String?
  service   Service?       @relation(fields: [serviceId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model TelegramBroadcast {
  id             String   @id @default(cuid())
  text           String
  recipientCount Int
  sentAt         DateTime @default(now())
}
